# ========= Notion =========
# Integration token (internal integration com acesso aos databases)
NOTION_TOKEN=

# IDs dos databases
NOTION_POSTAGENS_DB_ID=15bd04d23b4a804ba9cbf9be6c9932b3
NOTION_TAREFAS_DB_ID=15bd04d23b4a8073a6f6e5b85518a283
NOTION_PROJETOS_DB_ID=15bd04d23b4a805887fbccb19dcd8258
NOTION_CLIENTES_DB_ID=15bd04d23b4a80ef8b91db7b8b475505

# Nomes das properties (só muda se você renomear no Notion)
NOTION_POST_PROP_PROJETO=Projeto
NOTION_POST_PROP_DEMANDA="O que precisamos de você "
NOTION_POST_PROP_DATA=Data Postagem
NOTION_POST_PROP_STATUS=Status
NOTION_POST_PROP_DRIVE_LINK=Link do Google Drive
NOTION_POST_PROP_TAREFAS=Tarefas
NOTION_TASK_PROP_STATUS=Status
NOTION_TASK_PROP_FINALIZADA="Finalizada em "
NOTION_TASK_PROP_POST=Post
NOTION_TASK_PROP_PRONTO=" Pronto"
NOTION_PROJETO_PROP_EMAIL=Email do Cliente
NOTION_CLIENTE_PROP_EMAIL=E-mail da empresa
NOTION_CLIENTE_PROP_PROJETOS=Projetos

# ========= Google Drive (OAuth2) =========
# Cria em: console.cloud.google.com → APIs e serviços → Credenciais
#   → Criar credenciais → ID do cliente OAuth → Aplicação da Web
# Redirect URIs autorizados:
#   http://localhost:3000/api/setup/google/callback
#   https://SEU-DOMINIO/api/setup/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Deixa em branco no início. Depois de rodar /setup, cola aqui o refresh token que aparecer na tela.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Pasta raiz onde os materiais dos clientes serão organizados (na sua conta Google)
GOOGLE_DRIVE_ROOT_FOLDER_ID=1YV7-ZIGBHfpuLrxnAFGGcfocgnXEz-CX

# ========= Auth =========
# String aleatória. Gera com: openssl rand -base64 48
AUTH_SECRET=

# Email(s) que podem acessar /setup pra conectar o Google Drive. Separa por vírgula se for mais de um.
ADMIN_EMAILS=oi@lud.digital

# ========= Email (magic link) =========
RESEND_API_KEY=
MAIL_FROM="Lud. <oi@lud.digital>"

# ========= App =========
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========= Instagram (Graph API) =========
# Token long-lived do System User do Business Manager da Lud.
# Cria em: business.facebook.com → Configurações → Usuários do sistema → Gerar token
# Permissões: instagram_basic, instagram_manage_insights, pages_show_list,
#             pages_read_engagement, business_management
IG_GRAPH_TOKEN=

# Versão da Graph API (deixa o padrão se não souber)
IG_GRAPH_VERSION=v22.0

# Mapa de projeto (Notion) -> conta do Instagram (ig-user-id). Usado na área do cliente.
# JSON numa linha só. O ig-user-id aparece em /admin/analise no seletor de contas.
# Ex: IG_ACCOUNTS={"<projetoId>":"<igUserId>","<projetoId2>":"<igUserId2>"}
IG_ACCOUNTS=

# ========= Claude (Anthropic) =========
# Gera rascunhos de resposta pro atendimento no WhatsApp (modo "aprovar antes de enviar").
# Cria a chave em: console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Modelo usado nas sugestões. Padrão: Haiku (rápido e barato).
# Pra respostas mais sofisticadas: claude-opus-4-8
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
